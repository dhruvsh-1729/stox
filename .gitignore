# ---------------------------------------------------------------------------
# Secrets & credentials  (NEVER commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
cache/access_token.txt
**/access_token.txt
**/constants.py.local
*.pem
*.key

# ---------------------------------------------------------------------------
# Local data stores & caches (large, regenerable)
# ---------------------------------------------------------------------------
cache/
**/cache/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
*.db-journal
*.parquet
*.feather

# Downloaded market data / results / equity curves
results/
**/results/
data/parquet/
data/raw/
data/processed/
**/equity_curves/
**/exports/

# But keep small reference CSVs that ship with the repo
!data/nifty500.csv
!data/nifty_midcap.csv
!data/nifty_smallcap.csv

# Screen outputs at project root (regeneratable; screens write CSVs to root).
# Matches only top-level CSVs, so data/*.csv stays tracked.
/*.csv

